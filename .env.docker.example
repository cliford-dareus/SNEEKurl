# Copy to .env at the repo root before running docker compose:
#   cp .env.docker.example .env

# --- Required ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- App ---
NODE_ENV=development
ENVIRONMENT=development
PORT=4000
CLIENT_URL=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Mongo / Redis are set automatically by compose (service hostnames).
# Override only if you point at external services:
# MONGO_URI=mongodb://mongo:27017/sneekurl
# REDIS_URL=redis://redis:6379

# --- Client (dev) ---
VITE_API_URL=http://localhost:4000

# --- Production compose ---
# HTTP_PORT=8080
# VITE_API_URL=            # leave empty for same-origin via nginx

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# --- UploadThing ---
UPLOADTHING_TOKEN=your_uploadthing_token
