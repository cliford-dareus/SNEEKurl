# ===========================================
# SNEEKurl / LinkWise - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Core (required) ---
NODE_ENV=development
ENVIRONMENT=development
PORT=4000
CLIENT_URL=http://localhost:5173,http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-secret
MONGO_URI=mongodb://localhost:27017/sneekurl

# --- Redis (optional in development, recommended in production) ---
# Used for rate limiting and token blacklist
REDIS_URL=redis://localhost:6379

# --- Stripe (required for payments / subscriptions) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Optional: price IDs if you reference them in code
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# --- UploadThing (required for file uploads) ---
# Get these from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=your_uploadthing_token
# Older SDKs also accepted:
# UPLOADTHING_SECRET=sk_live_...
# UPLOADTHING_APP_ID=...

# --- Email / Nodemailer (optional – used for verification / password reset) ---
# In development the app can fall back to Ethereal test accounts.
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
